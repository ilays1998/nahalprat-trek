SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14
SQLALCHEMY_DATABASE_URI=postgresql://username:password@localhost:5432/dbname
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
OAUTH_REDIRECT_URI=https://yourdomain.com/api/auth/authorize
ADMIN_EMAIL=your_admin_email_here
FRONTEND_URL=http://localhost:3000
BACKEND_PORT=5001
FRONTEND_PORT=3000
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30

# Gmail SMTP configuration (recommended)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-username@gmail.com    # The Gmail account that sends emails
SMTP_PASSWORD=your-gmail-app-password          # Gmail App Password (NOT regular password)

# Contact form recipient email (where contact forms are delivered)
CONTACT_EMAIL=treknahalprat@gmail.com          # Can be same or different from SMTP_USERNAME

# IMPORTANT: For Gmail SMTP to work, you need to:
# 1. Enable 2-factor authentication on the SMTP_USERNAME Gmail account
# 2. Generate an App Password (not your regular Gmail password)
# 3. Use the 16-character App Password as SMTP_PASSWORD
# 4. Go to: Google Account → Security → 2-Step Verification → App passwords

